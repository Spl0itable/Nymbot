<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme while the process starts, dark mode off. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Splash shown until Flutter draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/appBackgroundColor</item>
        <item name="android:statusBarColor">@color/appBackgroundColor</item>
    </style>
    <!-- Window color behind the Flutter UI once the process has started. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:navigationBarColor">@color/appBackgroundColor</item>
        <item name="android:statusBarColor">@color/appBackgroundColor</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
