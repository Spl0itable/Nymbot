# `script-src` carries one `sha256-` beyond 'self', and only for the Cloudflare
# error pages under /errors/. They cannot link a script: Cloudflare stores one
# copy of each and serves it when this origin is unreachable, so anything they
# do not already contain is unavailable exactly when they are shown. It is one
# script (errors/runtime.js), byte-identical across all eight pages, so it is
# one hash rather than a per-page-per-language explosion. `ERROR-PAGE-RUNTIME`
# is a placeholder: `npm run build` replaces it with the real hash of what it
# just minified, and fails if it has gone missing.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-ERROR-PAGE-RUNTIME' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss: ws:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob: https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self' data:
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), idle-detection=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/images/*
  Cache-Control: public, max-age=86400, must-revalidate

/app/*
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

# The Cloudflare error pages. These are not browsed to — Cloudflare fetches each
# one, stores its own copy and serves that when this origin cannot be reached —
# so what this governs is the re-fetch. An error page whose copy changed should
# be picked up the next time Cloudflare asks for it, not served from a cache,
# and nothing here belongs in a search index.
/errors/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

/
  Cache-Control: public, max-age=0, must-revalidate

/*/
  Cache-Control: public, max-age=0, must-revalidate
